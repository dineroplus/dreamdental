# Dream Dental — local / production env template

# Neon (or any Postgres). Required for the site content layer and bookings.
DATABASE_URI=postgresql://USER:PASSWORD@HOST/db?sslmode=require

# Public site URL used for canonicals and cookies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dream Studio session signing. Use a long random string in production.
ADMIN_SESSION_SECRET=change-me-in-production

# Optional: create the first studio user with `npm run admin:create`
ADMIN_EMAIL=admin@dreamdental.ge
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional booking email notifications (Resend)
RESEND_API_KEY=
BOOKING_NOTIFY_TO=
BOOKING_NOTIFY_FROM=Dream Dental <onboarding@resend.dev>

# Optional R2 / S3 media (presigned uploads)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_PUBLIC_URL=

# Legacy Payload (kept until the old admin is fully removed)
PAYLOAD_SECRET=change-me
